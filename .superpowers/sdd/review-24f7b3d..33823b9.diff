risma.case.findUnique({ +    where: { id: caseId }, +    select: { patientId: true }, +  }); + +  if (!caseRecord) { +    return NextResponse.json({ error: 'Case not found' }, { status: 404 }); +  } + +  await notifyAdmin({ +    type: NOTIFICATION_TYPES.URGENT_FINDING, +    message, +    metadata: { caseId }, +  }); + +  await notifyPatient({ +    patientId: caseRecord.patientId, +    type: NOTIFICATION_TYPES.URGENT_FINDING, +    message: 'Your case has been flagged for urgent review. A specialist will contact you shortly.', +    metadata: { caseId }, +  }); + +  return NextResponse.json({ success: true }); +} diff --git a/app/api/cases/[id]/flag-incomplete/route.ts b/app/api/cases/[id]/flag-incomplete/route.ts new file mode 100644 index 0000000..e3a5a1b --- /dev/null +++ b/app/api/cases/[id]/flag-incomplete/route.ts @@ -0,0 +1,26 @@ +import { NextResponse } from 'next/server'; +import { getServerSession } from 'next-auth'; +import { authOptions } from '@/lib/auth'; +import { flagIncompleteUpload } from '@/lib/edge-cases/service'; + +export async function POST( +  request: Request, +  { params }: { params: Promise<{ id: string }> } +) { +  const session = await getServerSession(authOptions); +  if (!session) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 }); + +  const role = (session.user as { role: string }).role; +  if (role !== 'DOCTOR') return NextResponse.json({ error: 'Forbidden' }, { status: 403 }); + +  const { id } = await params; +  const { instructions } = await request.json(); +  if (!instructions) { +    return NextResponse.json({ error: 'instructions are required' }, { status: 400 }); +  } + +  const userId = (session.user as { id: string }).id; +  await flagIncompleteUpload(id, userId, instructions); + +  return NextResponse.json({ success: true }); +} diff --git a/app/api/cron/check-no-specialist/route.ts b/app/api/cron/check-no-specialist/route.ts new file mode 100644 index 0000000..d03b674 --- /dev/null +++ b/app/api/cron/check-