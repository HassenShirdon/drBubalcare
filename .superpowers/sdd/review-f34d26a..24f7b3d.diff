led(); +  }); + +  it('findBackupSpecialist returns next available specialist', async () => { +    vi.mocked(prisma.doctor.findMany).mockResolvedValue([ +      { userId: 'doc-2', specialty: 'Pathology', verified: true }, +    ] as any); + +    const result = await findBackupSpecialist('Pathology', 'doc-1'); +    expect(result).toBe('doc-2'); +  }); + +  it('findBackupSpecialist returns null when no backup available', async () => { +    vi.mocked(prisma.doctor.findMany).mockResolvedValue([]); + +    const result = await findBackupSpecialist('Pathology', 'doc-1'); +    expect(result).toBeNull(); +  }); + +  it('flagIncompleteUpload notifies patient with instructions', async () => { +    vi.mocked(prisma.case.findUnique).mockResolvedValue({ patientId: 'patient-1' } as any); + +    await flagIncompleteUpload('case-1', 'doc-1', 'Please upload pathology slides'); + +    expect(prisma.case.findUnique).toHaveBeenCalledWith({ +      where: { id: 'case-1' }, +      select: { patientId: true }, +    }); +    expect(notifyPatient).toHaveBeenCalledWith({ +      patientId: 'patient-1', +      type: 'INCOMPLETE_UPLOAD', +      message: 'Please upload pathology slides', +      metadata: { caseId: 'case-1', flaggedBy: 'doc-1' }, +    }); +  }); + +  it('flagIncompleteUpload does nothing when case not found', async () => { +    vi.mocked(prisma.case.findUnique).mockResolvedValue(null); + +    await flagIncompleteUpload('case-404', 'doc-1', 'Upload files'); + +    expect(notifyPatient).not.toHaveBeenCalled(); +  }); +}); diff --git a/lib/edge-cases/service.ts b/lib/edge-cases/service.ts new file mode 100644 index 0000000..adaa487 --- /dev/null +++ b/lib/edge-cases/service.ts @@ -0,0 +1,70 @@ +import { prisma } from '@/lib/db'; +import { notifyAdmin, notifyPatient, NOTIFICATION_TYPES } from '@/lib/notifications/service'; +import { EdgeCaseType } from './types'; + +const FOUR_HOURS_MS = 4 * 60 * 60 * 1000; + +export async function checkUnmatchedCases(): Promise<void> { +  const cutoff = new Date(Date.now() - FOUR_HOURS_MS); + +  const unmatchedCases = await prisma.case.findMany({ +    where: { +      status: 'OPEN', +      specialistId: null, +      createdAt: { lt: cutoff }, +    }, +    select: { id: true, patientId: true, createdAt: true }, +  }); + +  for (const c of unmatchedCases) { +    await notifyAdmin({ +      type: NOTIFICATION_TYPES.NO_SPECIALIST_MATCHED, +      message: `Case ${c.id} has been open for over 4 hours without a specialist`, +      metadata: { caseId: c.id, patientId: c.patientId }, +    }); + +    await notifyPatient({ +      patientId: c.patientId, +      type: NOTIFICATION_TYPES.NO_SPECIALIST_MATCHED, +      message: 'We are working to assign a specialist to your case. You will be notified once assigned.', +      metadata: { caseId: c.id }, +    }); +  } +} + +export async function findBackupSpecialist( +  specialty: string, +  excludeSpecialistId: string +): Promise<string | null> { +  const available = await prisma.doctor.findMany({ +    where: { +      specialty, +      verified: true, +      userId: { not: excludeSpecialistId }, +    }, +    select: { userId: true }, +    take: 1, +  }); + +  return available[0]?.userId ?? null; +} + +export async function flagIncompleteUpload( +  caseId: string, +  specialistId: string, +  instructions: string +): Promise<void> { +  const caseRecord = await prisma.case.findUnique({ +    where: { id: caseId }, +    select: { patientId: true }, +  }); + +  if (!caseRecord) return; + +  await notifyPatient({ +    patientId: caseRecord.patientId, +    type: NOTIFICATION_TYPES.INCOMPLETE_UPLOAD, +    message: instructions, +    metadata: { caseId, flaggedBy: specialistId }, +  }); +} diff --git a/lib/edge-cases/types.ts b/lib/edge-cases/types.ts new file mode 100644 index 0000000..e313ab1 --- /dev/null +++ b/lib/edge-cases/types.ts @@ -0,0 +1,15 @@ +export enum EdgeCaseType { +  NO_SPECIALIST_MATCHED = 'NO_SPECIALIST_MATCHED', +  URGENT_FINDING = 'URGENT_FINDING', +  INCOMPLETE_UPLOAD = 'INCOMPLETE_UPLOAD', +  SPECIALIST_UNAVAILABLE = 'SPECIALIST_UNAVAILABLE', +  PAYMENT_FAILED = 'PAYMENT_FAILED', +} + +export interface PendingEdgeCase { +  caseId: string; +  patientId: string; +  type: EdgeCaseType; +  createdAt: Date; +  details: string; +}
