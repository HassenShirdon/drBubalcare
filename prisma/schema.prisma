generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  // uncomment next line if you use Prisma <5.10
  // directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum LabStatus {
  NORMAL
  REVIEW_NEEDED
}

enum MetricStatus {
  NORMAL
  HIGH
  LOW
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CaseStatus {
  OPEN
  AI_PRE_SCREENED
  UNDER_REVIEW
  OPINION_READY
  CLOSED
  DISPUTED
}

enum OpinionStatus {
  DRAFT
  SIGNED
  DELIVERED
  DISPUTED
}

enum ServiceType {
  SPECIALIST_OPINION
  RESULT_INTERPRETATION
  FOLLOW_UP
  TREND_ANALYSIS
  EUROPEAN_REFERRAL
}

enum SynthesisStatus {
  PENDING
  GENERATED
  DELIVERED
}

enum DisputeStatus {
  PENDING
  UNDER_REVIEW
  PEER_REVIEW_ASSIGNED
  RESOLVED
  DISMISSED
}

enum DeletionStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ConsultationType {
  IN_PERSON
  VIRTUAL
}

enum ReferralStatus {
  SEARCHING
  MATCHED
  SCHEDULED
  COMPLETED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(PATIENT)
  age           Int?
  gender        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  doctorProfile       Doctor?
  patientAppointments Appointment[]         @relation("PatientAppointments")
  labResults          LabResult[]
  posts               Post[]
  cases               Case[]                @relation("PatientCases")
  specialistCases     Case[]                @relation("SpecialistCases")
  specialistOpinions  SpecialistOpinion[]
  auditLogs           AuditLog[]
  trendAnalyses       TrendAnalysis[]
  disputes            Dispute[]
  consentRecords      ConsentRecord[]
  deletionRequests    DataDeletionRequest[]
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  tags        String[]
  authorId    String
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Doctor {
  id           String   @id @default(cuid())
  userId       String   @unique
  specialty    String
  experience   String
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  locationType String   @default("Telehealth & In-person")
  bio          String?
  imageUrl     String?
  verified     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  services     DoctorService[]
  appointments Appointment[]   @relation("DoctorAppointments")
}

model DoctorService {
  id          String   @id @default(cuid())
  doctorId    String
  title       String
  description String?
  price       Float
  createdAt   DateTime @default(now())

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model Service {
  id          String @id @default(cuid())
  title       String
  description String
  icon        String
  category    String
}

model LabResult {
  id               String    @id @default(cuid())
  patientId        String
  name             String
  date             DateTime
  doctor           String
  status           LabStatus @default(NORMAL)
  icon             String
  aiInterpretation String?
  createdAt        DateTime  @default(now())

  patient User            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  metrics LabMetric[]
  trends  LabTrendPoint[]
}

model LabMetric {
  id             String       @id @default(cuid())
  labResultId    String
  name           String
  referenceRange String
  value          Float
  unit           String
  status         MetricStatus @default(NORMAL)

  labResult LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
}

model LabTrendPoint {
  id          String @id @default(cuid())
  labResultId String
  date        String
  value       Float

  labResult LabResult @relation(fields: [labResultId], references: [id], onDelete: Cascade)
}

model Appointment {
  id        String            @id @default(cuid())
  patientId String
  doctorId  String
  date      DateTime
  time      String
  status    AppointmentStatus @default(SCHEDULED)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  patient User   @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
}

model Case {
  id           String      @id @default(cuid())
  patientId    String
  specialistId String?
  serviceType  ServiceType
  status       CaseStatus  @default(OPEN)
  description  String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  patient              User                  @relation("PatientCases", fields: [patientId], references: [id], onDelete: Cascade)
  specialist           User?                 @relation("SpecialistCases", fields: [specialistId], references: [id], onDelete: SetNull)
  records              CaseRecord[]
  referralCoordination ReferralCoordination?
  intake               CaseIntake?
  opinions             SpecialistOpinion[]
  aiPrescreens         AIPrescreen[]
  synthesis            OpinionSynthesis?
  disputes             Dispute[]
}

model CaseIntake {
  id                     String      @id @default(cuid())
  caseId                 String      @unique
  age                    Int?
  sex                    String?
  serviceType            ServiceType
  reviewType             String?
  reasonForRequest       String[]
  mainConcern            String      @db.Text
  diagnosis              String?
  onsetDate              String?
  mainSymptoms           String?     @db.Text
  courseOfCondition      String?     @db.Text
  medicalHistory         String[]
  previousOperations     String?     @db.Text
  medications            Json?
  medicationAllergies    String?
  labTests               Json?
  imagingTypes           String[]
  imagingFindings        String?     @db.Text
  previousOpinions       String?     @db.Text
  questionsForReview     String?     @db.Text
  lifestyleFactors       String[]
  lifestyleNotes         String?
  familyHistory          String[]
  patientGoals           String?     @db.Text
  outcomeDecision        String?     @db.Text
  documentsToUpload      String[]
  requestedSpecialty     String?
  referralReason         String?
  referralUrgency        String?
  country                String?
  preferredLanguage      String?
  phone                  String?
  preferredCommunication String[]
  consentedToReview      Boolean     @default(false)
  confirmedAccuracy      Boolean     @default(false)
  consentedToProcessing  Boolean     @default(false)
  signatureName          String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseRecord {
  id         String   @id @default(cuid())
  caseId     String
  fileUrl    String
  fileType   String
  fileName   String
  uploadedAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ReferralCoordination {
  id               String            @id @default(cuid())
  caseId           String            @unique
  referralStatus   ReferralStatus    @default(SEARCHING)
  specialistName   String?
  specialistEmail  String?
  clinic           String?
  country          String?
  consultationType ConsultationType?
  coordinatorNotes String?           @db.Text
  scheduledAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model SpecialistOpinion {
  id           String        @id @default(cuid())
  caseId       String
  specialistId String
  content      String
  status       OpinionStatus @default(DRAFT)
  signedAt     DateTime?
  createdAt    DateTime      @default(now())

  case          Case                  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  specialist    User                  @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  plainSummary  PlainLanguageSummary?
  followUps     FollowUpQuestion[]
  dispute       Dispute?              @relation("DisputeOpinion")
  peerReviewFor Dispute?              @relation("PeerReviewOpinion")
}

model AIPrescreen {
  id            String   @id @default(cuid())
  caseId        String
  findings      String
  differentials String?
  urgentFlags   String?
  generatedAt   DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model OpinionSynthesis {
  id            String          @id @default(cuid())
  caseId        String          @unique
  content       String          @db.Text
  agreements    String[]
  disagreements String[]
  status        SynthesisStatus @default(PENDING)
  generatedAt   DateTime        @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model TrendAnalysis {
  id          String   @id @default(cuid())
  patientId   String
  metricName  String
  dataPoints  Json
  trend       String
  significant Boolean  @default(false)
  summary     String
  generatedAt DateTime @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, metricName])
}

model PlainLanguageSummary {
  id          String   @id @default(cuid())
  opinionId   String   @unique
  content     String
  generatedAt DateTime @default(now())

  opinion SpecialistOpinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)
}

model FollowUpQuestion {
  id        String   @id @default(cuid())
  opinionId String
  question  String
  answer    String
  scopeNote String?
  createdAt DateTime @default(now())

  opinion SpecialistOpinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resourceType String
  resourceId   String
  before       Json?
  after        Json?
  metadata     Json?
  timestamp    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id                  String        @id @default(cuid())
  caseId              String
  patientId           String
  opinionId           String?       @unique
  reason              String        @db.Text
  status              DisputeStatus @default(PENDING)
  adminNotes          String?       @db.Text
  resolution          String?       @db.Text
  peerReviewOpinionId String?       @unique
  createdAt           DateTime      @default(now())
  resolvedAt          DateTime?

  case              Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  patient           User               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  opinion           SpecialistOpinion? @relation("DisputeOpinion", fields: [opinionId], references: [id], onDelete: Cascade)
  peerReviewOpinion SpecialistOpinion? @relation("PeerReviewOpinion", fields: [peerReviewOpinionId], references: [id], onDelete: SetNull)
}

model ConsentRecord {
  id          String    @id @default(cuid())
  patientId   String
  consentType String
  granted     Boolean
  grantedAt   DateTime?
  revokedAt   DateTime?

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, consentType])
}

model DataDeletionRequest {
  id          String         @id @default(cuid())
  patientId   String
  status      DeletionStatus @default(PENDING)
  requestedAt DateTime
  executeAt   DateTime
  completedAt DateTime?

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
