# Database
# PostgreSQL connection string (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:port/database?sslmode=require"

# NextAuth Configuration
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="generate_a_random_64_char_hex_string"
NEXTAUTH_URL="http://localhost:3000"

# AI Configuration (DeepSeek primary, OpenAI fallback)
DEEPSEEK_API_KEY="your_deepseek_api_key"
OPENAI_API_KEY="your_openai_api_key"

# Internal service auth
# Used for AI trigger endpoints (prescreen, routing, summary, synthesis, trends)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET="generate_a_random_64_char_hex_string"

# Cron job auth
# Used by Vercel Cron Jobs or external schedulers
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="generate_a_random_64_char_hex_string"

# E2E test secret
# Used by Playwright tests to create test users and auth sessions
# Only works in non-production environments. Set a strong value in CI.
E2E_SECRET="set_a_random_value_for_ci"

# Application URL
# Must match the deployed URL (no trailing slash)
APP_URL="https://drbubalcare.com"
